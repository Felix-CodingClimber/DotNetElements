	private sealed class TreeItemPresenter : TreeItemData<string>
	{
		public bool IsLoopable { get; set; }
		public bool IsProperty { get; set; }
		public bool IsHint { get; set; }

		public TreeItemPresenter(string variableName) : base(variableName)
		{
			Text = variableName;
		}
	}

	// todo check if needed or if we need it public
	// check GetEnumerator warning
	// Helper class to support both property access and iteration
	private sealed class FlattenedLoopableVariable : ScriptObject, IEnumerable
	{
		private readonly List<object> items;

		public FlattenedLoopableVariable(ScriptObject properties, List<object> items)
		{
			this.items = items;

			// Copy all properties from the source object
			foreach (KeyValuePair<string, object?> kvp in properties)
			{
				this[kvp.Key] = kvp.Value;
			}
		}

		public IEnumerator GetEnumerator()
		{
			return items.GetEnumerator();
		}
	}
