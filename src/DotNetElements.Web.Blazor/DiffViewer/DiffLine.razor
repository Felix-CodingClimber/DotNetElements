@using DotNetElements.Core.StringDiff

<td style="@GetPositionStyle()" align="@(ViewMode is DiffViewerMode.SideBySide ? "left" : IsNewVersion ? "right" : "left")">
    @if (ViewMode is DiffViewerMode.Compact && ChangeType is ChangeType.Unchanged)
    {
        <div style="display: flex; justify-content: space-between;">
            <span>@(Position.ToString() ?? "")</span>
            <span>@(Position.ToString() ?? "")</span>
        </div>
    }
    else
    {
        @(Position.ToString() ?? "")
    }

</td>
<td style="width: 32px; vertical-align: middle; background-color: @BackgroundColor;" align="center">
    @if (ChangeType is not (ChangeType.Unchanged or ChangeType.Imaginary))
    {
        @if (IsNewVersion)
        {
            <span>+</span>
        }
        else
        {
            <span>-</span>
        }
    }
</td>
<td style="vertical-align: middle; background-color: @BackgroundColor;">
    @if (ChangeType is ChangeType.Unchanged)
    {
        <span style="@GetDiffPieceStyle(ChangeType)">
            @Text
        </span>
    }
    else
    {
        @if (SubPieces?.Count > 0)
        {
            @foreach (DiffPiece subPiece in SubPieces)
            {
                <span style="@GetDiffPieceStyle(subPiece.Type)">
                    @subPiece.Text
                </span>
            }
        }
        else
        {
            <span style="@GetDiffPieceStyle(ChangeType)">
                @Text
            </span>
        }
    }
</td>

@code
{
    [Parameter, EditorRequired]
    public string BackgroundColor { get; set; } = default!;

    [Parameter]
    public bool IsNewVersion { get; set; }

    [Parameter]
    public DiffViewerMode ViewMode { get; set; } = DiffViewerMode.Compact;

    [Parameter, EditorRequired]
    public ChangeType ChangeType { get; set; }

    [Parameter, EditorRequired]
    public int? Position { get; set; }

    [Parameter, EditorRequired]
    public string? Text { get; set; }

    [Parameter, EditorRequired]
    public List<DiffPiece>? SubPieces { get; set; }

    private string GetPositionStyle()
    {
        string style = $"vertical-align: middle; padding-left: 10px; padding-right: 10px; border-right: 1px solid var(--mud-palette-table-lines); background-color: {BackgroundColor};";

        style += $"width: {(ViewMode is DiffViewerMode.Compact ? "96px" : "64px")};";

        return style;
    }

    private string GetDiffPieceStyle(ChangeType changeType)
    {
        if (changeType is ChangeType.Unchanged)
            return "";

        string style = "border-radius: 10%; padding: 1px 4px;";

        if (changeType is ChangeType.Deleted or ChangeType.Modified)
            style += " background-color: #FFB6BA;";
        else if (changeType is ChangeType.Inserted)
            style += "background-color: #97F295;";

        return style;
    }
}
