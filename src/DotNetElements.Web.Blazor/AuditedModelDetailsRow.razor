@inherits MudComponentBase

@* todo check if TKey and TModel is really needed here *@
@typeparam TKey where TKey : notnull, IEquatable<TKey>
@typeparam TModel where TModel : IModel<TKey>
@typeparam TDetails where TDetails : CreationAuditedModelDetails

@if (Context.DetailsShown && Context.Details is not null)
{
    @if (SimpleTable)
    {
        <tr>
            <td colspan="100">
                <MudGrid Spacing="4">
                    <MudItem xs="11">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.caption"><b>ID</b></MudText>
                            <MudText Typo="Typo.caption">@Context.Value.Id</MudText>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="1" Class="d-flex flex-row align-start justify-end">
                        <CrudTableActionsButton OnClick="() => Context.DetailsShown = false" Icon="@Icons.Material.Outlined.ExpandLess" Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" />
                    </MudItem>
                    <MudItem xs="4">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.caption"><b>Creation Time</b></MudText>
                            <MudText Typo="Typo.caption">@Context.Details.CreationTime.ToFriendlyLocalDateTime()</MudText>
                        </MudStack>
                    </MudItem>
                    @if (Context.Details is AuditedModelDetails auditedModelDetails)
                    {
                        <MudItem xs="4">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption"><b>Last Modification Time</b></MudText>
                                <MudText Typo="Typo.caption">@auditedModelDetails.LastModificationTime.ToFriendlyLocalDateTime()</MudText>
                            </MudStack>
                        </MudItem>
                    }
                    @if (Context.Details is PersistentModelDetails persistentModelDetails)
                    {
                        <MudItem xs="4">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption"><b>Deletion Time</b></MudText>
                                <MudText Typo="Typo.caption">@persistentModelDetails.DeletionTime.ToFriendlyLocalDateTime()</MudText>
                            </MudStack>
                        </MudItem>
                    }
                </MudGrid>
            </td>
        </tr>
    }
    else
    {
        <MudTr>
            <MudTd colspan="100" Style="border-bottom: 3px solid var(--mud-palette-table-lines);" DataLabel="Row Details">
                <MudGrid Spacing="4">
                    <MudItem xs="11">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.caption"><b>ID</b></MudText>
                            <MudText Typo="Typo.caption">@Context.Value.Id</MudText>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="1" Class="d-flex flex-row align-start justify-end">
                        <CrudTableActionsButton OnClick="() => Context.DetailsShown = false" Icon="@Icons.Material.Outlined.ExpandLess" Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" />
                    </MudItem>
                    <MudItem xs="4">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.caption"><b>Creation Time</b></MudText>
                            <MudText Typo="Typo.caption">@Context.Details.CreationTime.ToFriendlyLocalDateTime()</MudText>
                        </MudStack>
                    </MudItem>
                    @if (Context.Details is AuditedModelDetails auditedModelDetails)
                    {
                        <MudItem xs="4">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption"><b>Last Modification Time</b></MudText>
                                <MudText Typo="Typo.caption">@auditedModelDetails.LastModificationTime.ToFriendlyLocalDateTime()</MudText>
                            </MudStack>
                        </MudItem>
                    }
                    @if (Context.Details is PersistentModelDetails persistentModelDetails)
                    {
                        <MudItem xs="4">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.caption"><b>Deletion Time</b></MudText>
                                <MudText Typo="Typo.caption">@persistentModelDetails.DeletionTime.ToFriendlyLocalDateTime()</MudText>
                            </MudStack>
                        </MudItem>
                    }
                </MudGrid>
            </MudTd>
        </MudTr>
    }
}

@code
{
    [Parameter, EditorRequired]
    public ModelWithDetails<TModel, TDetails> Context { get; set; } = default!;

    [Parameter]
    public bool SimpleTable { get; set; }
}