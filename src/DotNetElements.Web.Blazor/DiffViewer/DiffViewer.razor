@using DotNetElements.Core.StringDiff

@if (Diff?.OldText.HasDifferences is true || Diff?.NewText.HasDifferences is true)
{
    <table cellpadding="0" cellspacing="0" style="font-family: monospace, monospace; line-height: 1.5rem;">
        <tr>
            <th colspan="3" align="left" style="padding-left: 10px; border-bottom: 1px solid var(--mud-palette-table-lines)">Old &rarr; New</th>
        </tr>

        @foreach ((DiffPiece oldLine, DiffPiece newLine) in Diff.OldText.Lines.Zip(Diff.NewText.Lines))
        {
            @if (oldLine.Type is not ChangeType.Imaginary)
            {
                hasOldLine = true;

                <DiffLine Position="oldLine.Position"
                          ChangeType="oldLine.Type"
                          Text="@oldLine.Text"
                          SubPieces="oldLine.SubPieces"
                          BackgroundColor="@GetOldDiffLineBackground(oldLine)" />
            }
            else
            {
                hasOldLine = false;
            }

            @if (newLine.Type is not ChangeType.Unchanged and not ChangeType.Imaginary)
            {
                <DiffLine IsNewVersion="true"
                          Position="newLine.Position"
                          ChangeType="newLine.Type"
                          Text="@newLine.Text"
                          SubPieces="newLine.SubPieces"
                          BackgroundColor="@GetNewDiffLineBackground()" />
            }
        }
    </table>
}
else
{
    <div style="padding: 16px;">No differences found</div>
}

@code
{
    [Parameter, EditorRequired]
    public SideBySideDiffModel Diff { get; set; } = default!;

    private bool hasOldLine;

    private string GetOldDiffLineBackground(DiffPiece diffLine)
    {
        return diffLine.Type is ChangeType.Unchanged ? "" : "#FDF2D0;";
    }

    private string GetNewDiffLineBackground()
    {
        return hasOldLine ? "#DDEEDD" : "#DDFFDD";
    }
}
