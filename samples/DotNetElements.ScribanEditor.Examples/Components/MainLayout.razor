@inherits LayoutComponentBase

<MudProviders @bind-DarkModeActive="@darkModeActive" />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h5" Class="ml-3">ScribanEditor Example</MudText>
        <MudSpacer />
        <ThemeToggleButton @bind-DarkModeActive="darkModeActive" />
        <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End" />
    </MudAppBar>
    <MudMainContent Class="px-16">
        <MudContainer Class="my-16" MaxWidth="MaxWidth.False">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code
{
    private bool darkModeActive;
}