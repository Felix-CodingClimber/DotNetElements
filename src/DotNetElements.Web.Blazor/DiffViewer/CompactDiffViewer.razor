@using DotNetElements.Core.StringDiff

@inherits MudComponentBase

@if (Diff?.HasDifferences is true)
{
    <table cellpadding="0" cellspacing="0" class="@Class" style="background-color: var(@DnePalette.DiffLineUnchanged); font-family: monospace, monospace; line-height: 1.5rem; @Style">

        <tr>
            <th colspan="3" align="left" style="padding-left: 10px; border-bottom: 1px solid var(--mud-palette-table-lines)">@LabelOld &rarr; @LabelNew</th>
        </tr>

        @foreach (DiffPiece line in Diff.Lines)
        {
            @if (line.IsOldPiece)
            {
                hasOldLine = true;

                <tr>
                    <DiffLine Position="line.Position"
                              ChangeType="line.Type"
                              Text="@line.Text"
                              SubPieces="line.SubPieces"
                              BackgroundColor="@GetOldDiffLineBackground(line)" />
                </tr>
            }
            else
            {
                <tr>
                    <DiffLine IsNewVersion="true"
                              Position="line.Position"
                              ChangeType="line.Type"
                              Text="@line.Text"
                              SubPieces="line.SubPieces"
                              BackgroundColor="@($"var({DnePalette.DiffLineNew})")" />
                </tr>

                hasOldLine = false;
            }
        }
    </table>
}
else
{
    <div style="padding: 16px;">No differences found</div>
}

@code
{
    [Parameter, EditorRequired]
    public CompactDiffModel Diff { get; set; } = default!;

    [Parameter]
    public string LabelOld { get; set; } = "Old";

    [Parameter]
    public string LabelNew { get; set; } = "New";

    private bool hasOldLine;

    private string GetOldDiffLineBackground(DiffPiece diffLine)
    {
        return diffLine.Type is ChangeType.Unchanged ? $"var({DnePalette.DiffLineUnchanged})" : $"var({DnePalette.DiffLineOld})";
    }
}
