@using Microsoft.JSInterop
@using MudBlazor.Utilities

@inherits MudComponentBase

<style>
	.mud-tabs-dense {
	}

		.mud-tabs-dense .mud-tab {
			min-height: 34px;
			min-width: 100px !important;
			font-size: var(--mud-typography-subtitle2-size);
			font-family: var(--mud-typography-subtitle2-family);
			font-weight: var(--mud-typography-subtitle2-weight);
			line-height: var(--mud-typography-subtitle2-lineheight);
			letter-spacing: var(--mud-typography-subtitle2-letterspacing);
			text-transform: var(--mud-typography-subtitle2-text-transform);
		}

		.mud-tabs-dense .mud-tabs-tabbar-inner {
			min-height: 0px;
		}

		.mud-tabs-dense .mud-icon-button {
			padding: 0px;
			min-height: 34px;
			min-width: 34px;
		}

	.mud-tree-view-dense {
	}

		.mud-tree-view-dense .mud-icon-button {
			padding: 0px !important;
		}



	.variable-badge {
		display: inline-block;
		font-size: 0.65rem;
		padding: 1px 4px;
		margin-left: 4px;
		border-radius: 3px;
		font-weight: 500;
		vertical-align: middle;
	}

	.variable-badge-loopable {
		background-color: rgba(103, 58, 183, 0.2);
		color: var(--mud-palette-primary);
		border: 1px solid var(--mud-palette-primary);
	}

	.variable-badge-property {
		background-color: rgba(76, 175, 80, 0.2);
		color: #4caf50;
		border: 1px solid #4caf50;
	}
</style>

<div class="@Class" style="@Style" @attributes="UserAttributes">
	<div style="@GetMainContainerStyle()">
		@* Left Column - Template Variables & Help *@
		<div style="@GetSidebarStyle()">
			<div style="flex: 1; border-bottom: 1px solid var(--mud-palette-lines-default);">
				<div style="display: flex; align-items: center; padding: 4px 8px; min-height: 40px; border-bottom: 1px solid var(--mud-palette-lines-inputs); background-color: var(--mud-palette-surface);">
					<MudText Typo="Typo.subtitle2">Template Variables</MudText>
				</div>
				<MudTreeView Items="@availableVariablesTreeItems" ExpandOnClick="true" ReadOnly="true" Dense="true" Class="mud-tree-view-dense" Style="overflow-y: auto;">
					<ItemTemplate Context="treeItem">
						<MudTreeViewItem @bind-Expanded="@treeItem.Expanded" Items="@treeItem.Children" Value="@treeItem.Value">
							<Content>
								<div style="display: flex; align-items: center; gap: 4px;">
									<MudText Typo="Typo.subtitle2" Style="font-size: 0.8rem;">@treeItem.Text</MudText>
									@if (treeItem is not TreeItemPresenter presenter)
									{
										throw new InvalidOperationException("Expected tree item to be of type TreeItemPresenter");
									}

									@if (presenter.IsLoopable)
									{
										<span class="variable-badge variable-badge-loopable" title="Can be used in for loops">loop</span>
									}
									@if (presenter.IsProperty)
									{
										<span class="variable-badge variable-badge-property" title="Property">prop</span>
									}
								</div>
							</Content>
						</MudTreeViewItem>
					</ItemTemplate>
				</MudTreeView>
			</div>
			<div style="display: flex; flex-direction: column; flex: 1; overflow: hidden;">
				<MudTabs Class="mud-tabs-dense">
					<MudTabPanel Text="Syntax">
						<div style="overflow-y: auto; padding: 8px;">
							<MudText Typo="Typo.subtitle2" Class="mb-2">Scriban Syntax</MudText>
						</div>
					</MudTabPanel>
					<MudTabPanel Text="Functions">
						<div style="overflow-y: auto; padding: 8px;">
							<MudText Typo="Typo.subtitle2" Class="mb-3">String Functions</MudText>

							@foreach (ScribanFunctionDefinition func in BuiltInStringFunctions)
							{
								<div class="mb-3">
									<MudText Typo="Typo.body2" Style="font-weight: 600; font-size: 0.8rem;">@func.Name</MudText>
									<MudText Typo="Typo.caption" Color="Color.Tertiary" Class="mb-1">@func.Description</MudText>

									@if (func.FunctionParams.Length > 0)
									{
										<div class="ml-2">
											<MudText Typo="Typo.caption" Style="font-style: italic; font-size: 0.7rem;">Parameters:</MudText>
											@foreach (FunctionParam param in func.FunctionParams)
											{
												<MudText Typo="Typo.caption" Class="ml-2" Style="font-size: 0.7rem;">
													• <strong>@param.Name:</strong> @param.Description
												</MudText>
											}
										</div>
									}
								</div>
							}
						</div>
					</MudTabPanel>
				</MudTabs>
			</div>
		</div>

		@* Middle & Right Columns - Editor and Preview *@
		<div style="display: flex; flex-direction: column; flex: 1; overflow: hidden;">
			@* Toolbar *@
			<div style="display: flex; align-items: center; padding: 4px 8px; min-height: 40px; border-bottom: 1px solid var(--mud-palette-lines-inputs); background-color: var(--mud-palette-surface);">
				<MudSpacer />
				@if (PreviewEnabled)
				{
					<MudIconButton Icon="@(previewShown? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
								   Color="Color.Default"
								   Size="Size.Small"
								   OnClick="TogglePreview" />
				}
			</div>

			@* Editor and Preview Row *@
			<div style="display: flex; flex-direction: row; flex: 1; overflow: hidden;">
				@* Editor Column *@
				<div @ref="editorContainer" style="flex: 1; overflow: hidden;" />

				@* Preview Column *@
				@if (previewShown)
				{
					<div style="display: flex; flex-direction: column; flex: 1; padding: 12px; border-left: 1px solid var(--mud-palette-lines-inputs); background-color: var(--mud-palette-background); overflow: hidden;">
						<MudText Typo="Typo.subtitle2" Class="mb-2">Preview</MudText>
						<div style="flex: 1; overflow-y: auto;">
							<MudText Typo="Typo.body2" Color="Color.Tertiary">
								Rendered template preview will be displayed here
							</MudText>
							@* TODO: Add rendered preview content here *@
						</div>
					</div>
				}
			</div>
		</div>
	</div>
</div>

@code
{
	[Parameter]
	public string? InitialContent { get; set; }

	[Parameter]
	public bool Resizable { get; set; } = true;

	[Parameter]
	public bool PreviewEnabled { get; set; } = true;

	[Parameter]
	public string? MinHeight { get; set; } = "100px";

	[Parameter]
	public string? MaxHeight { get; set; }

	[Parameter]
	public string SidebarWidth { get; set; } = "250px";

	private EditorTheme preferredTheme = EditorTheme.Dark;
	private IReadOnlyList<ScribanVariableDefinition> availableVariables = [];

	private bool previewShown;
	private IReadOnlyList<TreeItemData<string>> availableVariablesTreeItems { get; set; } = [];

	private bool editorInitialized;

	private ElementReference editorContainer;

	private readonly IJSRuntime jsRuntime;

	public ScribanEditor(IJSRuntime jsRuntime)
	{
		this.jsRuntime = jsRuntime;
	}

	public ValueTask<string> GetContentAsync()
	{
		return GetEditorContentAsync();
	}

	public ValueTask SetContentAsync(string content)
	{
		return SetEditorContentAsync(content);
	}

	public async ValueTask SetAvailableVariablesAsync(IEnumerable<ScribanVariableDefinition> variables)
	{
		availableVariables = variables.ToList();
		availableVariablesTreeItems = BuildTreeItems(availableVariables);

		if (!editorInitialized)
			return;

		await SetScribanVariablesAsync(availableVariables);
	}

	public async ValueTask SetIsDarkModeActiveAsync(bool isDarkMode)
	{
		preferredTheme = isDarkMode ? EditorTheme.Dark : EditorTheme.Light;

		if (!editorInitialized)
			return;

		await SetEditorThemeAsync(preferredTheme);
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender)
			return;

		await InitEditorAsync();
	}

	private void TogglePreview()
	{
		previewShown = !previewShown;
	}

	private List<TreeItemData<string>> BuildTreeItems(IReadOnlyList<ScribanVariableDefinition> variables)
	{
		List<TreeItemData<string>> items = [];

		foreach (ScribanVariableDefinition varDef in variables)
		{
			TreeItemPresenter item = new(varDef.Name)
			{
				IsLoopable = varDef.IsLoopable,
				IsProperty = false
			};

			List<TreeItemData<string>> children = [];

			// Add properties first
			if (varDef.Properties.Length > 0)
			{
				foreach (string property in varDef.Properties)
				{
					children.Add(new TreeItemPresenter(property)
					{
						IsLoopable = false,
						IsProperty = true
					});
				}
			}

			// Add child variables
			if (varDef.ChildVars.Length > 0)
			{
				// Only show children if not loopable OR if flatten is enabled
				bool shouldShowChildren = !varDef.IsLoopable || varDef.FlattenChildren;

				if (shouldShowChildren)
				{
					children.AddRange(BuildTreeItems(varDef.ChildVars));
				}
				else if (varDef.IsLoopable)
				{
					// For loop-only variables, show item properties directly
					// Get the first child as a representative (all items have the same structure)
					ScribanVariableDefinition firstChild = varDef.ChildVars[0];

					// Add hint text as a direct child
					children.Add(new TreeItemPresenter("Item properties:")
					{
						IsLoopable = false,
						IsProperty = false,
						IsHint = true
					});

					// Add properties directly at the same level
					if (firstChild.Properties.Length > 0)
					{
						foreach (string property in firstChild.Properties)
						{
							children.Add(new TreeItemPresenter(property)
							{
								IsLoopable = false,
								IsProperty = true
							});
						}
					}
				}
			}

			item.Children = children;
			items.Add(item);
		}

		return items;
	}
	private string GetMainContainerStyle()
	{
		StyleBuilder builder = new();
		builder.AddStyle("display: flex");
		builder.AddStyle("flex-direction: row");
		builder.AddStyle("border: 1px solid var(--mud-palette-lines-inputs)");
		builder.AddStyle("border-radius: var(--mud-default-borderradius)");
		builder.AddStyle("height: 100%");
		builder.AddStyle("overflow: hidden");
		builder.AddStyle("resize: vertical", Resizable);
		builder.AddStyle("min-height", MinHeight, MinHeight is not null);
		builder.AddStyle("max-height", MaxHeight, MaxHeight is not null);

		return builder.Build();
	}

	private string GetSidebarStyle()
	{
		StyleBuilder builder = new();
		builder.AddStyle("resize: horizontal");
		builder.AddStyle("display: flex");
		builder.AddStyle("flex-direction: column");
		builder.AddStyle("width", SidebarWidth);
		builder.AddStyle("border-right: 1px solid var(--mud-palette-lines-inputs)");
		builder.AddStyle("background-color: var(--mud-palette-background-grey)");
		builder.AddStyle("overflow: hidden");

		return builder.Build();
	}

	// scriban-editor.js interop helpers
	private async ValueTask InitEditorAsync()
	{
		await jsRuntime.InvokeVoidAsync("ScribanEditor.initEditor", editorContainer);

		await SetEditorThemeAsync(preferredTheme);

		if (availableVariables.Count > 0)
			await SetScribanVariablesAsync(availableVariables);

		if (!string.IsNullOrEmpty(InitialContent))
			await SetEditorContentAsync(InitialContent);

		editorInitialized = true;

		StateHasChanged();
	}

	private ValueTask SetEditorContentAsync(string content)
	{
		return jsRuntime.InvokeVoidAsync("ScribanEditor.setEditorContent", editorContainer, content);
	}

	private ValueTask<string> GetEditorContentAsync()
	{
		return jsRuntime.InvokeAsync<string>("ScribanEditor.getEditorContent", editorContainer);
	}

	private ValueTask SetScribanFunctionsAsync(IEnumerable<ScribanFunctionDefinition> functions)
	{
		return jsRuntime.InvokeVoidAsync("ScribanEditor.setScribanFunctions", editorContainer, functions);
	}

	private ValueTask SetScribanVariablesAsync(IEnumerable<ScribanVariableDefinition> variables)
	{
		return jsRuntime.InvokeVoidAsync("ScribanEditor.setScribanVariables", editorContainer, variables);
	}

	private ValueTask SetEditorThemeAsync(EditorTheme theme)
	{
		return jsRuntime.InvokeVoidAsync("ScribanEditor.setEditorTheme", editorContainer, theme.ToString().ToLowerInvariant());
	}

	private sealed record class ScribanFunctionDefinition(string Name, string Description, FunctionParam[] FunctionParams);
	private sealed record class FunctionParam(string Name, string Description);

	private enum EditorTheme
	{
		Dark,
		Light,
	}

	// Scriban built-in string functions
	private static readonly ScribanFunctionDefinition[] BuiltInStringFunctions =
	[
		new("string.append", "Appends a string to another string", [new("text", "The string to append")]),
		new("string.capitalize", "Capitalizes the first character of the string", []),
		new("string.downcase", "Converts the string to lowercase", []),
		new("string.upcase", "Converts the string to uppercase", []),
		new("string.strip", "Removes whitespace from both ends", []),
		new("string.lstrip", "Removes whitespace from the left end", []),
		new("string.rstrip", "Removes whitespace from the right end", []),
		new("string.replace", "Replaces occurrences of a string", [new("old", "The string to find"), new("new", "The replacement string")]),
		new("string.replace_first", "Replaces the first occurrence", [new("old", "The string to find"), new("new", "The replacement string")]),
		new("string.remove", "Removes all occurrences of a string", [new("text", "The string to remove")]),
		new("string.remove_first", "Removes the first occurrence", [new("text", "The string to remove")]),
		new("string.slice", "Extracts a substring", [new("start", "Starting position (0-based)"), new("length", "Number of characters (optional)")]),
		new("string.split", "Splits string into an array", [new("delimiter", "The string to split on")]),
		new("string.starts_with", "Checks if string starts with text", [new("text", "The text to check for")]),
		new("string.ends_with", "Checks if string ends with text", [new("text", "The text to check for")]),
		new("string.contains", "Checks if string contains text", [new("text", "The text to search for")]),
		new("string.truncate", "Truncates string to length", [new("length", "Maximum length")]),
		new("string.truncatewords", "Truncates to word count", [new("count", "Maximum number of words")]),
		new("string.pad_left", "Pads string on the left", [new("width", "Total width after padding"), new("char", "Character to pad with (optional, default: space)")]),
		new("string.pad_right", "Pads string on the right", [new("width", "Total width after padding"), new("char", "Character to pad with (optional, default: space)")]),
		new("string.pluralize", "Returns singular or plural form", [new("count", "Number to check"), new("singular", "Singular form"), new("plural", "Plural form")]),
		new("string.md5", "Computes MD5 hash", []),
		new("string.sha1", "Computes SHA1 hash", []),
		new("string.sha256", "Computes SHA256 hash", []),
		new("string.hmac_sha1", "Computes HMAC SHA1", [new("key", "The secret key")]),
		new("string.hmac_sha256", "Computes HMAC SHA256", [new("key", "The secret key")]),
		new("string.handle", "Converts to URL-friendly string", []),
		new("string.handleize", "Converts to handleized string", [])
	];

	private sealed class TreeItemPresenter : TreeItemData<string>
	{
		public bool IsLoopable { get; set; }
		public bool IsProperty { get; set; }
		public bool IsHint { get; set; }

		public TreeItemPresenter(string variableName) : base(variableName)
		{
			Text = variableName;
		}
	}
}
