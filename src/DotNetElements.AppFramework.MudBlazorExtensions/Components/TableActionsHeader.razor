@inherits MudComponentBase

@if (SimpleTable)
{
    <th class="@Class" style="@($"width: {Width}px;") @Style">
        Actions
    </th>
}
else
{
    <MudTh Class="@Class" Style="@($"width: {Width}px; {@Style}")">
        Actions
    </MudTh>
}

@code
{
    [Parameter]
    public bool SimpleTable { get; set; }

    [Parameter]
    public int Width { get; set; } = 140;
}