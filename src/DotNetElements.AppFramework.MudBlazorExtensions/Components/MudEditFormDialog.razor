@using DotNetElements.AppFramework.MudBlazorExtensions.Util

@typeparam TValue
@typeparam TReturnValue

<MudDialogEx DefaultFocus="@DefaultFocus">
    <DialogContent>
        @if (Value is not null && (!OnLoad.HasDelegate || isLoaded))
        {
            <EditForm @ref="editFormRef" Model="@Value" @onkeydown="OnKeyDownAsync">
                <DataAnnotationsValidator />
                @FormContent(Value)
            </EditForm>
        }
        else if (hasError)
        {
            <MudAlert Severity="Severity.Error">@(errorMessage ?? "Unknown error")</MudAlert>
        }
        else
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
    </DialogContent>
    <DialogActions>
        @if (CustomDialogActions is not null)
        {
            @CustomDialogActions
        }
        <MudButton OnClick="OnCancelAsync_Internal" Variant="Variant.Outlined" Class="ml-4">@CancelButtonText</MudButton>
        @if (Value is not null)
        {
            <MudButton Color="Color.Primary" OnClick="OnSubmitAsync_Internal" Variant="Variant.Filled" Disabled="@SubmitButtonDisabled" Class="ml-4">@SubmitButtonText</MudButton>
        }
    </DialogActions>
</MudDialogEx>

@code
{
    [CascadingParameter]
    IMudDialogInstance DialogInstance { get; set; } = default!;

    [Parameter, EditorRequired]
    public TValue? Value { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment<TValue> FormContent { get; set; } = default!;

    [Parameter]
    public RenderFragment? CustomDialogActions { get; set; }

    [Parameter]
    public EventCallback<EditFormLoadArgs> OnLoad { get; set; }

    [Parameter]
    public EventCallback<EditFormSubmitArgs<TValue, TReturnValue>> OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public bool SubmitButtonDisabled { get; set; }

    [Parameter]
    public string SubmitButtonText { get; set; } = "Submit";

    [Parameter]
    public string CancelButtonText { get; set; } = "Cancel";

    [Parameter]
    public bool SubmitOnEnter { get; set; } = true;

    /// <summary>
    /// Specifies which element should receive focus when the dialog is shown.
    /// Defaults to <see cref="DefaultFocus.FirstChild"/>.
    /// </summary>
    /// <remarks>
    /// Make sure to use <see cref="DefaultFocus.None"/> if you want to use AutoFocus="true" on a form field.
    /// </remarks>
    [Parameter]
    public DefaultFocus DefaultFocus { get; set; } = DefaultFocus.FirstChild;

    private EditForm? editFormRef;

    private bool isLoaded;
    private bool hasError;
    private string? errorMessage;

    public bool Validate()
    {
        ArgumentNullException.ThrowIfNull(editFormRef);
        ArgumentNullException.ThrowIfNull(editFormRef.EditContext);

        return editFormRef.EditContext.Validate();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!OnLoad.HasDelegate)
            return;

        EditFormLoadArgs args = new();
        await OnLoad.InvokeAsync(args);

        if (!args.HasError)
        {
            isLoaded = true;
            return;
        }

        hasError = true;
        errorMessage = args.ErrorMessage;
        isLoaded = true;
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (!SubmitOnEnter)
            return;

        if (e.Key != "Enter")
            return;

        if (SubmitButtonDisabled)
            return;

        await OnSubmitAsync_Internal();
    }

    private async Task OnSubmitAsync_Internal()
    {
        ArgumentNullException.ThrowIfNull(Value);
        ArgumentNullException.ThrowIfNull(editFormRef);
        ArgumentNullException.ThrowIfNull(editFormRef.EditContext);

        EditFormSubmitArgs<TValue, TReturnValue> args = new(Value, editFormRef.EditContext);

        if (OnSubmit.HasDelegate)
            await OnSubmit.InvokeAsync(args);

        if (args.Cancel)
            return;

        DialogInstance.Close(DialogResult.Ok(args.ReturnValue));
    }

    private async Task OnCancelAsync_Internal()
    {
        if (OnCancel.HasDelegate)
            await OnCancel.InvokeAsync();

        DialogInstance.Cancel();
    }
}
