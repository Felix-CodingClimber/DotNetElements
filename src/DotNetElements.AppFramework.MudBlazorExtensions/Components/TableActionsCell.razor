@inherits MudComponentBase

@typeparam TModel
@typeparam TDetails where TDetails : ModelDetails

@if (SimpleTable)
{
    <td class="py-0 pl-2 @Class" style="@($"white-space: nowrap; width: 0px; text-align: right; {Style}")">
        <TableActionsButton OnClick="() => OnEditEntry.InvokeAsync(Context)" Disabled="@EditButtonDisabled" Icon="@EditButtonIcon" Color="Color.Warning" Style="@(EditButtonShown ? "visibility: visible;" : "visibility: hidden;")" />
        <TableActionsButton OnClick="() => OnDeleteEntry.InvokeAsync(Context)" Disabled="@DeleteButtonDisabled" Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Style="@(DeleteButtonShown ? "visibility: visible;" : "visibility: hidden;")" />
        @ChildContent
        <TableActionsButton OnClick="() => OnShowEntryDetails.InvokeAsync(Context)" Disabled="@DetailsButtonDisabled" Icon="@Icons.Material.Outlined.Info" Color="Color.Default" Style="@(DetailsButtonShown ? "visibility: visible;" : "visibility: hidden;")" />
    </td>
}
else
{
    <MudTd Class="@($"py-0 pl-2 {@Class}")" Style="@($"white-space: nowrap; width: 0px; text-align: right; {Style}")" DataLabel="Actions">
        <TableActionsButton OnClick="() => OnEditEntry.InvokeAsync(Context)" Disabled="@EditButtonDisabled" Icon="@EditButtonIcon" Color="Color.Warning" Style="@(EditButtonShown ? "visibility: visible;" : "visibility: hidden;")" />
        <TableActionsButton OnClick="() => OnDeleteEntry.InvokeAsync(Context)" Disabled="@DeleteButtonDisabled" Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Style="@(DeleteButtonShown ? "visibility: visible;" : "visibility: hidden;")" />
        @ChildContent
        <TableActionsButton OnClick="() => OnShowEntryDetails.InvokeAsync(Context)" Disabled="@DetailsButtonDisabled" Icon="@Icons.Material.Outlined.Info" Color="Color.Default" Style="@(DetailsButtonShown ? "visibility: visible;" : "visibility: hidden;")" />
    </MudTd>
}

@code
{
    [Parameter, EditorRequired]
    public ModelWithDetails<TModel, TDetails> Context { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback<ModelWithDetails<TModel, TDetails>> OnEditEntry { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<ModelWithDetails<TModel, TDetails>> OnDeleteEntry { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<ModelWithDetails<TModel, TDetails>> OnShowEntryDetails { get; set; }

    [Parameter]
    public bool SimpleTable { get; set; }

    [Parameter]
    public bool EditButtonShown { get; set; } = true;

    [Parameter]
    public bool EditButtonDisabled { get; set; }

    [Parameter]
    public string EditButtonIcon { get; set; } = Icons.Material.Outlined.Edit;

    [Parameter]
    public bool DeleteButtonShown { get; set; } = true;

    [Parameter]
    public bool DeleteButtonDisabled { get; set; }

    [Parameter]
    public bool DetailsButtonShown { get; set; } = true;

    [Parameter]
    public bool DetailsButtonDisabled { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}