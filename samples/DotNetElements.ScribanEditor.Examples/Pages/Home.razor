@page "/"

@using DotNetElements.ScribanEditor.Examples.Utils

<ScribanEditor @ref="scribanEditorRef" Style="height: 80vh;" />

@code
{
    private ScribanEditor? scribanEditorRef;
    private readonly IThemeProvider themeProvider;

    public Home(IThemeProvider themeProvider)
    {
        this.themeProvider = themeProvider;
        themeProvider.ThemeChanged += OnThemeChanged;
    }

    private void OnThemeChanged(object? sender, EventArgs e)
    {
        scribanEditorRef?.SetIsDarkModeActiveAsync(themeProvider.IsDarkModeActive);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        ArgumentNullException.ThrowIfNull(scribanEditorRef);

        await scribanEditorRef.SetIsDarkModeActiveAsync(themeProvider.IsDarkModeActive);
        await scribanEditorRef.SetAvailableVariablesAsync(variableDefinitions);
    }

    private static readonly ScribanVariableDefinition[] variableDefinitions =
    [
        new ScribanVariableDefinition()
        {
            Name = "vars",
            ChildVars =
            [
                new ScribanVariableDefinition()
                {
                    Name = "FirstName",
                    Properties = ["Value", "Label"],
                    DefaultExampleValue = "John"
                },
                new ScribanVariableDefinition()
                {
                    Name = "LastName",
                    Properties = ["Value", "Label"],
                    DefaultExampleValue = "Doe"
                },
                new ScribanVariableDefinition()
                {
                    Name = "Email",
                    Properties = ["Value", "Label"],
                    DefaultExampleValue = "john.doe@example.com"
                },
                new ScribanVariableDefinition()
                {
                    Name = "Options1",
                    FlattenChildren = true,
                    IsLoopable = true,
                    ChildVars =
                    [
                        new ScribanVariableDefinition()
                        {
                            Name = "OptionA",
                            Properties = ["Value", "Label"],
                            DefaultExampleValue = "option_a"
                        },
                        new ScribanVariableDefinition()
                        {
                            Name = "OptionB",
                            Properties = ["Value", "Label"],
                            DefaultExampleValue = "option_b"
                        },
                        new ScribanVariableDefinition()
                        {
                            Name = "OptionC",
                            Properties = ["Value", "Label"],
                            DefaultExampleValue = "option_c"
                        }
                    ]
                },
                new ScribanVariableDefinition()
                {
                    Name = "Options2",
                    IsLoopable = true,
                    ChildVars =
                    [
                        new ScribanVariableDefinition()
                        {
                            Name = "OptionA",
                            Properties = ["Value", "Label"],
                            DefaultExampleValue = "choice_a"
                        },
                        new ScribanVariableDefinition()
                        {
                            Name = "OptionB",
                            Properties = ["Value", "Label"],
                            DefaultExampleValue = "choice_b"
                        },
                        new ScribanVariableDefinition()
                        {
                            Name = "OptionC",
                            Properties = ["Value", "Label"],
                            DefaultExampleValue = "choice_c"
                        }
                    ]
                }
            ]
        },
        new ScribanVariableDefinition()
        {
            Name = "env",
            ChildVars =
            [
                new ScribanVariableDefinition()
                {
                    Name = "LocalNow",
                    DefaultExampleValue = "2024-02-28 14:30:00"
                },
                new ScribanVariableDefinition()
                {
                    Name = "Environment",
                    DefaultExampleValue = "Development"
                },
                new ScribanVariableDefinition()
                {
                    Name = "ApiVersion",
                    DefaultExampleValue = "v1.0.0"
                }
            ]
        }
    ];
}
