@using DotNetElements.AppFramework.MudBlazorExtensions.Util

@typeparam TReturnValue

<MudDialogEx>
    <DialogContent>
        @if (!OnLoad.HasDelegate || isLoaded)
        {
            @ChildContent
        }
        else if (hasError)
        {
            <MudAlert Severity="Severity.Error">@(errorMessage ?? "Unknown error")</MudAlert>
        }
        else
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
    </DialogContent>
    <DialogActions>
        @if (CustomDialogActions is not null)
        {
            @CustomDialogActions
        }
        @if (CancelButtonShown)
        {
            <MudButton OnClick="OnCancelAsync_Internal" Variant="Variant.Outlined" Class="ml-4">@CancelButtonText</MudButton>
        }
        <MudButton Color="Color.Primary" OnClick="OnOkAsync_Internal" Variant="Variant.Filled" Disabled="@OkButtonDisabled" Class="ml-4">@OkButtonText</MudButton>
    </DialogActions>
</MudDialogEx>

@code
{
    [CascadingParameter]
    IMudDialogInstance DialogInstance { get; set; } = default!;

    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;

    [Parameter]
    public RenderFragment? CustomDialogActions { get; set; }

    [Parameter]
    public EventCallback<DialogLoadArgs> OnLoad { get; set; }

    [Parameter]
    public EventCallback<DialogSubmitArgs<TReturnValue>> OnOk { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public bool OkButtonDisabled { get; set; }

    [Parameter]
    public string OkButtonText { get; set; } = "Ok";

    [Parameter]
    public bool CancelButtonShown { get; set; } = true;

    [Parameter]
    public string CancelButtonText { get; set; } = "Cancel";

    private bool isLoaded;
    private bool hasError;
    private string? errorMessage;

    public void Close(TReturnValue returnValue)
    {
        DialogInstance.Close(DialogResult.Ok(returnValue));
    }

    protected override async Task OnInitializedAsync()
    {
        if (!OnLoad.HasDelegate)
            return;

        DialogLoadArgs args = new();
        await OnLoad.InvokeAsync(args);

        if (!args.HasError)
            return;

        hasError = true;
        errorMessage = args.ErrorMessage;
        isLoaded = true;
    }

    private async Task OnOkAsync_Internal()
    {
        DialogSubmitArgs<TReturnValue> args = new();

        if (OnOk.HasDelegate)
            await OnOk.InvokeAsync(args);

        if (args.Cancel)
            return;

        DialogInstance.Close(DialogResult.Ok(args.ReturnValue));
    }

    private async Task OnCancelAsync_Internal()
    {
        if (OnCancel.HasDelegate)
            await OnCancel.InvokeAsync();

        DialogInstance.Cancel();
    }
}
